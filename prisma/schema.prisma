generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SupplyRisk {
  HIGH
  MEDIUM
  LOW
}

enum MovementType {
  IN
  OUT
  TRANSFER
}

enum ProductCondition {
  NEW
  USED
}

enum SerialStatus {
  IN_STOCK
  OUT
  IN_REPAIR
  SCRAPPED
  LOST
}

enum OrderStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELLED
}

enum SiteType {
  STORAGE
  EXIT
}

model AssemblyType {
  id             String                 @id @default(uuid())
  name           String                 @unique
  description    String?
  createdAt      DateTime               @default(now())
  assemblies     AssemblyAssemblyType[]
  products       ProductAssemblyType[]
  items          AssemblyTypeItem[]

  @@map("assembly_types")
}

model ProductAssemblyType {
  productId      String
  assemblyTypeId String
  qtyPerUnit     Int          @default(1)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  assemblyType   AssemblyType @relation(fields: [assemblyTypeId], references: [id], onDelete: Cascade)

  @@id([productId, assemblyTypeId])
  @@map("product_assembly_types")
}

model AssemblyTypeItem {
  id             String        @id @default(uuid())
  assemblyTypeId String
  assemblyType   AssemblyType  @relation(fields: [assemblyTypeId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  partCategoryId String?
  partCategory   PartCategory? @relation(fields: [partCategoryId], references: [id], onDelete: SetNull)

  @@unique([assemblyTypeId, productId])
  @@map("assembly_type_items")
}

model Assembly {
  id            String                 @id @default(uuid())
  name          String                 @unique
  description   String?
  createdAt     DateTime               @default(now())
  products      Product[]
  assemblyTypes AssemblyAssemblyType[]

  @@map("assemblies")
}

model AssemblyAssemblyType {
  id             String       @id @default(uuid())
  assemblyId     String
  assembly       Assembly     @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  assemblyTypeId String
  assemblyType   AssemblyType @relation(fields: [assemblyTypeId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([assemblyId, assemblyTypeId])
  @@map("assembly_assembly_types")
}

model Supplier {
  id               String            @id @default(uuid())
  name             String            @unique
  contact          String?
  email            String?
  phone            String?           // Téléphone fixe uniquement (pas de portable)
  website          String?
  address          String?           // Rue, numéro
  postalCode       String?
  city             String?
  country          String?
  latitude         Decimal?          @db.Decimal(10, 8)
  longitude        Decimal?          @db.Decimal(11, 8)
  comment          String?
  createdAt        DateTime          @default(now())
  // --- Company data fetched from recherche-entreprises.api.gouv.fr ---
  /// SIRET du siège (14 chiffres). Si renseigné, sert de clef pour le rafraîchissement.
  siret            String?
  /// SIREN (9 chiffres). Dérivé du SIRET (9 premiers chiffres) si disponible.
  siren            String?
  /// Nom officiel renvoyé par l'API.
  legalName        String?
  /// État administratif : "A" actif, "C" cessé / fermé.
  legalStatus      String?
  /// Code NAF (ex 6201Z).
  naf              String?
  /// Libellé d'activité du NAF.
  nafLabel         String?
  /// Année de création (extraite de la date de création de l'entreprise).
  creationYear     Int?
  /// Date du dernier fetch des données officielles.
  companyInfoUpdatedAt DateTime?
  productSuppliers ProductSupplier[]
  orders           Order[]
  contacts         SupplierContact[]
  orderTemplates   OrderTemplate[]

  @@index([siret])
  @@map("suppliers")
}

model SupplierContact {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  position    String?  // Poste
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("supplier_contacts")
}

model Site {
  id              String          @id @default(uuid())
  name            String          @unique
  type            SiteType
  address         String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  stocks          Stock[]
  sourceMovements StockMovement[] @relation("SourceSite")
  targetMovements StockMovement[] @relation("TargetSite")
  orders          Order[]
  orderTemplates  OrderTemplate[]
  serialItems     ProductSerialItem[]
  locations       Location[]

  @@map("sites")
}

/// Hierarchical storage location attached to a Site.
/// Self-referencing: a level-1 entry (e.g. "Allée 1") may or may not have children
/// (e.g. "Rack A"). A Product points to either a level-1 (when no children exist)
/// or a level-2 (sub-location) entry — never both.
model Location {
  id        String     @id @default(uuid())
  siteId    String?
  site      Site?      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Location?  @relation("LocationChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Location[] @relation("LocationChildren")
  name      String
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  products  Product[]

  // A given name is unique within its (site, parent) scope. Postgres allows
  // multiple NULL parentIds without violating the unique index — so two level-1
  // siblings can share a name only if they belong to different sites.
  @@unique([siteId, parentId, name])
  @@index([siteId, parentId])
  @@map("locations")
}

model Product {
  id               String            @id @default(uuid())
  reference        String            @unique
  description      String?
  supplyRisk       SupplyRisk?
  location         String?
  locationId       String?
  storageLocation  Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assemblyId       String?
  assembly         Assembly?         @relation(fields: [assemblyId], references: [id], onDelete: SetNull)
  comment          String?
  imageUrl         String?
  externalLinks    ProductExternalLink[]
  minStock         Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  productSuppliers ProductSupplier[]
  stocks           Stock[]
  movements        StockMovement[]
  orderItems       OrderItem[]
  packItems        PackItem[]
  orderTemplateItems OrderTemplateItem[]
  partCategories   ProductPartCategory[]
  comments         ProductComment[]
  assemblyTypeItems AssemblyTypeItem[]
  assemblyTypes    ProductAssemblyType[]
  priceHistory     ProductPriceHistory[]
  hasSerialNumber  Boolean              @default(false)
  serialItems      ProductSerialItem[]
  auditLog         ProductAuditLog[]

  @@map("products")
}

model ProductExternalLink {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
  @@map("product_external_links")
}

model ProductAuditLog {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Type of change: 'created' | 'updated' | 'field' | 'assembly_type_added' | 'assembly_type_removed' |
  /// 'assembly_type_qty' | 'part_category_added' | 'part_category_removed' | 'supplier_added' |
  /// 'supplier_removed'
  action      String
  /// Name of the field for action='field' (e.g. 'reference', 'minStock', 'description').
  /// Otherwise the entity name involved (e.g. assembly type name, category name, supplier name).
  field       String?
  oldValue    String?
  newValue    String?
  changedAt   DateTime @default(now())
  changedById String?
  changedByName String?

  @@index([productId, changedAt])
  @@map("product_audit_log")
}

model ProductSerialItem {
  id            String           @id @default(uuid())
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  serialNumber  String?
  condition     ProductCondition
  siteId        String?
  site          Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  status        SerialStatus     @default(IN_STOCK)
  enteredAt     DateTime         @default(now())
  exitedAt      DateTime?
  borneNumber   String?
  comment       String?
  /// Set when this unit came in as part of an accepted reception anomaly. The
  /// item is in stock (condition stays NEW) but is flagged as a known issue.
  hasAnomaly      Boolean        @default(false)
  anomalyComment  String?
  createdAt     DateTime         @default(now())
  createdById   String?
  createdByName String?
  updatedAt     DateTime         @updatedAt

  @@unique([productId, serialNumber])
  @@index([productId, status])
  @@index([siteId, status])
  @@map("product_serial_items")
}

model ProductPriceHistory {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId     String
  supplierName   String
  unitPrice      Decimal  @db.Decimal(10, 2)
  changedAt      DateTime @default(now())
  changedById    String?
  changedByName  String?

  @@index([productId, changedAt])
  @@map("product_price_history")
}

model ProductComment {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  content        String
  authorId       String
  authorUsername String
  authorName     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
  @@index([authorId])
  @@map("product_comments")
}

model ProductSupplier {
  id             String    @id @default(uuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierRef    String?
  unitPrice      Decimal?  @db.Decimal(10, 2)
  leadTime       String?
  productUrl     String?
  shippingCost   Decimal?  @db.Decimal(10, 2)
  isPrimary      Boolean   @default(false)
  priceUpdatedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model Stock {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  quantityNew  Int      @default(0)
  quantityUsed Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([productId, siteId])
  @@map("stocks")
}

model StockMovement {
  id           String           @id @default(uuid())
  productId    String
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         MovementType
  sourceSiteId String?
  sourceSite   Site?            @relation("SourceSite", fields: [sourceSiteId], references: [id])
  targetSiteId String?
  targetSite   Site?            @relation("TargetSite", fields: [targetSiteId], references: [id])
  quantity     Int
  condition    ProductCondition
  movementDate DateTime
  operator     String?
  comment      String?
  createdAt    DateTime         @default(now())

  @@index([productId])
  @@index([movementDate])
  @@map("stock_movements")
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  title             String?
  supplierId        String
  supplier          Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status            OrderStatus @default(PENDING)
  orderDate         DateTime
  expectedDate      DateTime?
  receivedDate      DateTime?
  destinationSiteId String?
  destinationSite   Site?       @relation(fields: [destinationSiteId], references: [id])
  responsible       String?
  supplierRef       String?
  comment           String?
  shippingCost      Decimal?    @db.Decimal(10, 2)
  createdBy         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  comments          OrderComment[]
  attachments       OrderAttachment[]
  auditLog          OrderAuditLog[]

  @@index([status])
  @@index([orderDate])
  @@map("orders")
}

model OrderAuditLog {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Type of change: 'created' | 'field' | 'status' | 'item_received' | 'item_anomaly' |
  /// 'attachment_added' | 'attachment_removed'
  action        String
  /// Field name for 'field' actions, item label or attachment filename otherwise.
  field         String?
  oldValue      String?
  newValue      String?
  changedAt     DateTime @default(now())
  changedById   String?
  changedByName String?

  @@index([orderId, changedAt])
  @@map("order_audit_log")
}

model OrderAttachment {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Original file name as uploaded by the user (for display).
  filename      String
  /// Path on disk under /uploads (served as a static asset).
  url           String
  /// Detected MIME type (kept for icon / preview decisions).
  mimeType      String?
  /// File size in bytes.
  size          Int?
  uploadedAt    DateTime @default(now())
  uploadedById  String?
  uploadedByName String?

  @@index([orderId, uploadedAt])
  @@map("order_attachments")
}

model OrderComment {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  content        String
  authorId       String
  authorUsername String
  authorName     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
  @@index([authorId])
  @@map("order_comments")
}

model OrderItem {
  id           String                    @id @default(uuid())
  orderId      String
  order        Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int
  unitPrice    Decimal?                  @db.Decimal(10, 2)
  receivedQty  Int?
  receivedDate DateTime?
  condition    String?
  anomalies    OrderItemAnomaly[]

  @@map("order_items")
}

enum AnomalyDecision {
  ACCEPTED
  REFUSED
}

model OrderItemAnomaly {
  id            String          @id @default(uuid())
  orderItemId   String
  orderItem     OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /// Number of units affected by the anomaly (subset of receivedQty + refused).
  quantity      Int
  decision      AnomalyDecision
  comment       String
  /// Optional photo URLs uploaded by the receiver.
  photoUrls     String[]        @default([])
  reportedAt    DateTime        @default(now())
  reportedById  String?
  reportedByName String?

  @@index([orderItemId])
  @@map("order_item_anomalies")
}

model Pack {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       PackItem[]

  @@map("packs")
}

model PackItem {
  id        String  @id @default(uuid())
  packId    String
  pack      Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([packId, productId])
  @@map("pack_items")
}

model OrderTemplate {
  id                String              @id @default(uuid())
  name              String              @unique
  supplierId        String
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  destinationSiteId String?
  destinationSite   Site?               @relation(fields: [destinationSiteId], references: [id])
  responsible       String?
  comment           String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  items             OrderTemplateItem[]

  @@map("order_templates")
}

model OrderTemplateItem {
  id         String        @id @default(uuid())
  templateId String
  template   OrderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int
  unitPrice  Decimal?      @db.Decimal(10, 2)

  @@unique([templateId, productId])
  @@map("order_template_items")
}

model PartCategory {
  id                 String                @id @default(uuid())
  // Uniqueness is enforced case-insensitively at the DB level
  // via a UNIQUE INDEX on LOWER(name) (see migration
  // 20260505100000_dedupe_part_categories_case_insensitive).
  name               String
  description        String?
  createdAt          DateTime              @default(now())
  products           ProductPartCategory[]
  assemblyTypeItems  AssemblyTypeItem[]

  @@map("part_categories")
}

model ProductPartCategory {
  id             String       @id @default(uuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  partCategoryId String
  partCategory   PartCategory @relation(fields: [partCategoryId], references: [id], onDelete: Cascade)

  @@unique([productId, partCategoryId])
  @@map("product_part_categories")
}

// Local cache of platform users. Upserted at every login (see /users/sync)
// so we can render avatars, full name and profile picture for any operator
// that has ever connected, without round-tripping the gateway each time.
model User {
  id         String   @id @default(uuid())
  keycloakId String   @unique
  email      String?
  firstName  String?
  lastName   String?
  fullName   String?
  photoNom   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fullName])
  @@map("users")
}

