generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SupplyRisk {
  HIGH
  MEDIUM
  LOW
}

enum MovementType {
  IN
  OUT
  TRANSFER
}

enum ProductCondition {
  NEW
  USED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SiteType {
  STORAGE
  EXIT
}

model AssemblyType {
  id             String                 @id @default(uuid())
  name           String                 @unique
  description    String?
  createdAt      DateTime               @default(now())
  assemblies     AssemblyAssemblyType[]
  products       Product[]
  items          AssemblyTypeItem[]

  @@map("assembly_types")
}

model AssemblyTypeItem {
  id             String        @id @default(uuid())
  assemblyTypeId String
  assemblyType   AssemblyType  @relation(fields: [assemblyTypeId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  partCategoryId String?
  partCategory   PartCategory? @relation(fields: [partCategoryId], references: [id], onDelete: SetNull)

  @@unique([assemblyTypeId, productId])
  @@map("assembly_type_items")
}

model Assembly {
  id            String                 @id @default(uuid())
  name          String                 @unique
  description   String?
  createdAt     DateTime               @default(now())
  products      Product[]
  assemblyTypes AssemblyAssemblyType[]

  @@map("assemblies")
}

model AssemblyAssemblyType {
  id             String       @id @default(uuid())
  assemblyId     String
  assembly       Assembly     @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  assemblyTypeId String
  assemblyType   AssemblyType @relation(fields: [assemblyTypeId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([assemblyId, assemblyTypeId])
  @@map("assembly_assembly_types")
}

model Supplier {
  id               String            @id @default(uuid())
  name             String            @unique
  contact          String?
  email            String?
  phone            String?           // Téléphone fixe uniquement (pas de portable)
  website          String?
  address          String?           // Rue, numéro
  postalCode       String?
  city             String?
  country          String?
  latitude         Decimal?          @db.Decimal(10, 8)
  longitude        Decimal?          @db.Decimal(11, 8)
  comment          String?
  createdAt        DateTime          @default(now())
  productSuppliers ProductSupplier[]
  orders           Order[]
  contacts         SupplierContact[]
  orderTemplates   OrderTemplate[]

  @@map("suppliers")
}

model SupplierContact {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  position    String?  // Poste
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("supplier_contacts")
}

model Site {
  id              String          @id @default(uuid())
  name            String          @unique
  type            SiteType
  address         String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  stocks          Stock[]
  sourceMovements StockMovement[] @relation("SourceSite")
  targetMovements StockMovement[] @relation("TargetSite")
  orders          Order[]
  orderTemplates  OrderTemplate[]

  @@map("sites")
}

model Product {
  id               String            @id @default(uuid())
  reference        String            @unique
  description      String?
  qtyPerUnit       Int               @default(1)
  supplyRisk       SupplyRisk?
  location         String?
  assemblyId       String?
  assembly         Assembly?         @relation(fields: [assemblyId], references: [id], onDelete: SetNull)
  assemblyTypeId   String?
  assemblyType     AssemblyType?     @relation(fields: [assemblyTypeId], references: [id], onDelete: SetNull)
  comment          String?
  imageUrl         String?
  minStock         Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  productSuppliers ProductSupplier[]
  stocks           Stock[]
  movements        StockMovement[]
  orderItems       OrderItem[]
  packItems        PackItem[]
  orderTemplateItems OrderTemplateItem[]
  partCategories   ProductPartCategory[]
  comments         ProductComment[]
  assemblyTypeItems AssemblyTypeItem[]
  priceHistory     ProductPriceHistory[]

  @@map("products")
}

model ProductPriceHistory {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId     String
  supplierName   String
  unitPrice      Decimal  @db.Decimal(10, 2)
  changedAt      DateTime @default(now())
  changedById    String?
  changedByName  String?

  @@index([productId, changedAt])
  @@map("product_price_history")
}

model ProductComment {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  content        String
  authorId       String
  authorUsername String
  authorName     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
  @@index([authorId])
  @@map("product_comments")
}

model ProductSupplier {
  id             String    @id @default(uuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierRef    String?
  unitPrice      Decimal?  @db.Decimal(10, 2)
  leadTime       String?
  productUrl     String?
  shippingCost   Decimal?  @db.Decimal(10, 2)
  isPrimary      Boolean   @default(false)
  priceUpdatedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model Stock {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  quantityNew  Int      @default(0)
  quantityUsed Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([productId, siteId])
  @@map("stocks")
}

model StockMovement {
  id           String           @id @default(uuid())
  productId    String
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         MovementType
  sourceSiteId String?
  sourceSite   Site?            @relation("SourceSite", fields: [sourceSiteId], references: [id])
  targetSiteId String?
  targetSite   Site?            @relation("TargetSite", fields: [targetSiteId], references: [id])
  quantity     Int
  condition    ProductCondition
  movementDate DateTime
  operator     String?
  comment      String?
  createdAt    DateTime         @default(now())

  @@index([productId])
  @@index([movementDate])
  @@map("stock_movements")
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  title             String?
  supplierId        String
  supplier          Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status            OrderStatus @default(PENDING)
  orderDate         DateTime
  expectedDate      DateTime?
  receivedDate      DateTime?
  destinationSiteId String?
  destinationSite   Site?       @relation(fields: [destinationSiteId], references: [id])
  responsible       String?
  supplierRef       String?
  comment           String?
  createdBy         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  comments          OrderComment[]

  @@index([status])
  @@index([orderDate])
  @@map("orders")
}

model OrderComment {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  content        String
  authorId       String
  authorUsername String
  authorName     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
  @@index([authorId])
  @@map("order_comments")
}

model OrderItem {
  id           String    @id @default(uuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int
  unitPrice    Decimal?  @db.Decimal(10, 2)
  receivedQty  Int?
  receivedDate DateTime?
  condition    String?

  @@map("order_items")
}

model Pack {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       PackItem[]

  @@map("packs")
}

model PackItem {
  id        String  @id @default(uuid())
  packId    String
  pack      Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([packId, productId])
  @@map("pack_items")
}

model OrderTemplate {
  id                String              @id @default(uuid())
  name              String              @unique
  supplierId        String
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  destinationSiteId String?
  destinationSite   Site?               @relation(fields: [destinationSiteId], references: [id])
  responsible       String?
  comment           String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  items             OrderTemplateItem[]

  @@map("order_templates")
}

model OrderTemplateItem {
  id         String        @id @default(uuid())
  templateId String
  template   OrderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int
  unitPrice  Decimal?      @db.Decimal(10, 2)

  @@unique([templateId, productId])
  @@map("order_template_items")
}

model PartCategory {
  id                 String                @id @default(uuid())
  name               String                @unique
  description        String?
  createdAt          DateTime              @default(now())
  products           ProductPartCategory[]
  assemblyTypeItems  AssemblyTypeItem[]

  @@map("part_categories")
}

model ProductPartCategory {
  id             String       @id @default(uuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  partCategoryId String
  partCategory   PartCategory @relation(fields: [partCategoryId], references: [id], onDelete: Cascade)

  @@unique([productId, partCategoryId])
  @@map("product_part_categories")
}

